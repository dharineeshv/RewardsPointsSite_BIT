{
  "rules": {
    "logs": {
      /* Block unauthorized direct GET requests to /logs.json */
      ".read": "auth != null && (auth.token.email == 'dharineesh.ct23@bitsathy.ac.in' || auth.token.admin == true)",
      /* Allow append-only writing for valid log items (cannot overwrite or delete existing logs) */
      "$log_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['studentId', 'timestamp']) || newData.hasChildren(['rollNo']) || newData.hasChildren(['action'])"
      }
    },
    "active_users": {
      /* Restrict reading active users stream to authorized admins */
      ".read": "auth != null && (auth.token.email == 'dharineesh.ct23@bitsathy.ac.in' || auth.token.admin == true)",
      /* Allow students to update their active presence heartbeat */
      "$user_id": {
        ".write": true
      }
    },
    "ps_session": {
      /* Master PS Portal cookie/token collection - strictly admin only */
      ".read": "auth != null && (auth.token.email == 'dharineesh.ct23@bitsathy.ac.in' || auth.token.admin == true)",
      ".write": "auth != null && (auth.token.email == 'dharineesh.ct23@bitsathy.ac.in' || auth.token.admin == true)"
    },
    "placement_data": {
      /* Placement records are publicly readable by students, but writes restricted */
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'dharineesh.ct23@bitsathy.ac.in' || auth.token.admin == true)"
    },
    /* Default deny-all for all other unlisted collections and root access */
    ".read": false,
    ".write": false
  }
}